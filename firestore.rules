rules_version = '2';
// Blackgram 2.2 — Firestore Security Rules (ЧЕРНОВИК, не проверен на эмуляторе).
// Перед публикацией сохрани текущие правила из консоли Firebase и проверь новые в Rules Playground.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.lower() == 'iliuhagosp@gmail.com';
    }
    function myProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdminWith(perm) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myProfile().get('role', 'user') == 'admin'
        && perm in myProfile().get('permissions', []);
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.get('blocked', false) == false
        && (isOwner() || (request.resource.data.get('role', 'user') == 'user'
            && !('verified' in request.resource.data)
            && !('permissions' in request.resource.data)));
      allow update: if isOwner()
        || (signedIn() && request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['role', 'permissions', 'verified', 'blocked', 'email']))
        || (isAdminWith('blockUsers') && uid != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blocked', 'blockReason']))
        || (isAdminWith('verifyUsers')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified']));
      allow delete: if false;
    }

    match /chats/{chatId} {
      // get разрешён и для ещё не существующего документа: приложение проверяет наличие чата перед созданием
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() && request.auth.uid in resource.data.participants
        && (resource.data.createdBy == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['lastText', 'lastSenderId', 'lastAt']));
      allow delete: if false;

      match /messages/{msgId} {
        function chatData() { return get(/databases/$(database)/documents/chats/$(chatId)).data; }
        function isMember() { return signedIn() && request.auth.uid in chatData().participants; }
        function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

        allow read: if isMember();
        allow create: if isMember()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000;
        allow update: if isMember() && (
          // автор правит текст своего сообщения
          (resource.data.senderId == request.auth.uid && changed().hasOnly(['text', 'editedAt']))
          // любой участник меняет только СВОЮ реакцию
          || (changed().hasOnly(['reacts'])
              && request.resource.data.get('reacts', {}).diff(resource.data.get('reacts', {}))
                   .affectedKeys().hasOnly([request.auth.uid])));
        allow delete: if isMember()
          && (resource.data.senderId == request.auth.uid || chatData().createdBy == request.auth.uid);
      }
    }

    match /calls/{callId} {
      function isParty() { return resource.data.from == request.auth.uid || resource.data.to == request.auth.uid; }
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
      allow read, update: if signedIn() && isParty();

      match /{kind}/{candId} {
        function callPath() { return /databases/$(database)/documents/calls/$(callId); }
        // id звонка имеет вид call_<время>_<uid звонящего>; кандидаты звонящего пишутся до создания документа звонка
        function isCaller() { return callId.matches('call_[0-9]+_' + request.auth.uid); }
        allow create: if signedIn() && (isCaller()
          || (exists(callPath()) && get(callPath()).data.to == request.auth.uid));
        allow read: if signedIn() && exists(callPath())
          && (get(callPath()).data.from == request.auth.uid || get(callPath()).data.to == request.auth.uid);
      }
    }

    // Журнал действий: записи неизменяемые; чтение доступно владельцу и админам с viewLogs.
    match /adminLog/{id} {
      allow create: if signedIn() && request.resource.data.by == request.auth.uid
        && (isOwner() || isAdminWith('blockUsers') || isAdminWith('verifyUsers')
            || isAdminWith('manageSettings') || isAdminWith('manageReports') || isAdminWith('manageGroups'));
      allow read: if isOwner() || isAdminWith('viewLogs');
      allow update, delete: if false;
    }

    // Системные настройки доступны для чтения авторизованным клиентам; менять их может владелец или админ с manageSettings.
    match /systemConfig/{configId} {
      allow read: if signedIn();
      allow create, update: if isOwner() || isAdminWith('manageSettings');
      allow delete: if isOwner();
    }

    // Объявления публикуются только владельцем или админом с manageSettings и не редактируются задним числом.
    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.by == request.auth.uid
        && (isOwner() || isAdminWith('manageSettings'))
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 3
        && request.resource.data.message.size() <= 500;
      allow update, delete: if isOwner();
    }


    // Пользовательские жалобы: отправитель создаёт только свою жалобу;
    // читать и менять статус могут владелец и модераторы с manageReports.
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetId != request.auth.uid
        && request.resource.data.category is string
        && request.resource.data.details is string
        && request.resource.data.details.size() >= 5
        && request.resource.data.details.size() <= 1000
        && request.resource.data.status == 'new';
      allow read: if isOwner() || isAdminWith('manageReports');
      allow update: if (isOwner() || isAdminWith('manageReports'))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status','reviewedBy','reviewedAt'])
        && request.resource.data.status in ['new','reviewed','resolved'];
      allow delete: if isOwner();
    }
  }
}
